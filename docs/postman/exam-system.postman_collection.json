{
  "info": {
    "name": "Exam System API (Spring Boot)",
    "description": "智汇学场（Spring Boot）后端 API 全集：考试 + 竞赛/竞技化 + 征集悬赏 + 自主学习（v4.0）。使用方法：1) 先运行【01-认证】中的「登录-教师」「登录-学生」自动写入 token；2) 按文件夹顺序调用。默认账号 teacher/123123、student1/123123。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "teacherToken", "value": "" },
    { "key": "studentToken", "value": "" },
    { "key": "examId", "value": "1" },
    { "key": "questionId", "value": "1" },
    { "key": "newQuestionId", "value": "" },
    { "key": "newExamId", "value": "" },
    { "key": "studentId", "value": "2" },
    { "key": "invitationCode", "value": "TEST1234" },
    { "key": "notificationId", "value": "1" },
    { "key": "competitionId", "value": "" },
    { "key": "battleId", "value": "" },
    { "key": "bountyId", "value": "" },
    { "key": "submissionId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [ { "key": "token", "value": "{{teacherToken}}", "type": "string" } ]
  },
  "item": [
    {
      "name": "01-认证 Auth",
      "item": [
        {
          "name": "注册（公开）",
          "request": {
            "auth": { "type": "noAuth" },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": [ "{{baseUrl}}" ], "path": [ "api", "auth", "register" ] },
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"new_student\",\n  \"password\": \"123123\",\n  \"email\": \"new@example.com\",\n  \"role\": \"student\"\n}" }
          }
        },
        {
          "name": "登录-教师（自动保存 teacherToken）",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "const res = pm.response.json();",
                "pm.test('登录成功', () => pm.expect(res.code).to.eql(200));",
                "if (res.data && res.data.token) pm.collectionVariables.set('teacherToken', res.data.token);"
              ] }
            }
          ],
          "request": {
            "auth": { "type": "noAuth" },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": [ "{{baseUrl}}" ], "path": [ "api", "auth", "login" ] },
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"teacher\",\n  \"password\": \"123123\"\n}" }
          }
        },
        {
          "name": "登录-学生（自动保存 studentToken）",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "const res = pm.response.json();",
                "if (res.data && res.data.token) pm.collectionVariables.set('studentToken', res.data.token);"
              ] }
            }
          ],
          "request": {
            "auth": { "type": "noAuth" },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": [ "{{baseUrl}}" ], "path": [ "api", "auth", "login" ] },
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"student1\",\n  \"password\": \"123123\"\n}" }
          }
        },
        {
          "name": "当前用户 me",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": [ "{{baseUrl}}" ], "path": [ "api", "auth", "me" ] }
          }
        },
        {
          "name": "错误密码登录（预期 401）",
          "request": {
            "auth": { "type": "noAuth" },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": [ "{{baseUrl}}" ], "path": [ "api", "auth", "login" ] },
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"teacher\",\n  \"password\": \"wrong\"\n}" }
          }
        }
      ]
    },
    {
      "name": "02-基础数据 院系/专业/课程/章节",
      "item": [
        { "name": "题型字典（公开）", "request": { "auth": { "type": "noAuth" }, "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/question-types", "host": ["{{baseUrl}}"], "path": ["api", "question-types"] } } },
        { "name": "难度字典（公开）", "request": { "auth": { "type": "noAuth" }, "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/difficulties", "host": ["{{baseUrl}}"], "path": ["api", "difficulties"] } } },
        { "name": "院系列表", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/departments", "host": ["{{baseUrl}}"], "path": ["api", "departments"] } } },
        { "name": "专业列表（可按 departmentId 过滤）", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/majors?departmentId=1", "host": ["{{baseUrl}}"], "path": ["api", "majors"], "query": [{ "key": "departmentId", "value": "1" }] } } },
        { "name": "专业详情", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/majors/1", "host": ["{{baseUrl}}"], "path": ["api", "majors", "1"] } } },
        { "name": "新建专业", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/api/majors", "host": ["{{baseUrl}}"], "path": ["api", "majors"] }, "body": { "mode": "raw", "raw": "{\n  \"name\": \"软件工程\",\n  \"description\": \"Postman 测试专业\",\n  \"departmentId\": 1\n}" } } },
        { "name": "更新专业", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/api/majors/1", "host": ["{{baseUrl}}"], "path": ["api", "majors", "1"] }, "body": { "mode": "raw", "raw": "{\n  \"name\": \"计算机科学与技术\",\n  \"description\": \"CS 本科（更新）\",\n  \"departmentId\": 1\n}" } } },
        { "name": "删除专业", "request": { "method": "DELETE", "header": [], "url": { "raw": "{{baseUrl}}/api/majors/999", "host": ["{{baseUrl}}"], "path": ["api", "majors", "999"] } } },
        { "name": "课程列表（可按 majorId 过滤）", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/courses?majorId=1", "host": ["{{baseUrl}}"], "path": ["api", "courses"], "query": [{ "key": "majorId", "value": "1" }] } } },
        { "name": "新建课程（教师）", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/api/courses", "host": ["{{baseUrl}}"], "path": ["api", "courses"] }, "body": { "mode": "raw", "raw": "{\n  \"name\": \"操作系统\",\n  \"description\": \"专业核心课\",\n  \"credit\": 4,\n  \"semester\": 3,\n  \"majorId\": 1\n}" } } },
        { "name": "更新课程（教师）", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/api/courses/1", "host": ["{{baseUrl}}"], "path": ["api", "courses", "1"] }, "body": { "mode": "raw", "raw": "{\n  \"name\": \"数据结构\",\n  \"description\": \"基础课程（更新）\",\n  \"credit\": 3,\n  \"semester\": 2,\n  \"majorId\": 1\n}" } } },
        { "name": "删除课程（教师）", "request": { "method": "DELETE", "header": [], "url": { "raw": "{{baseUrl}}/api/courses/999", "host": ["{{baseUrl}}"], "path": ["api", "courses", "999"] } } },
        { "name": "章节列表（教师，必传 courseId）", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/chapters?courseId=1", "host": ["{{baseUrl}}"], "path": ["api", "chapters"], "query": [{ "key": "courseId", "value": "1" }] } } },
        { "name": "章节详情（教师）", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/chapters/1", "host": ["{{baseUrl}}"], "path": ["api", "chapters", "1"] } } },
        { "name": "新建章节（教师）", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/api/chapters", "host": ["{{baseUrl}}"], "path": ["api", "chapters"] }, "body": { "mode": "raw", "raw": "{\n  \"name\": \"第三章 树与二叉树\",\n  \"description\": \"树形结构\",\n  \"orderNum\": 3,\n  \"courseId\": 1\n}" } } },
        { "name": "更新章节（教师）", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/api/chapters/1", "host": ["{{baseUrl}}"], "path": ["api", "chapters", "1"] }, "body": { "mode": "raw", "raw": "{\n  \"name\": \"第一章 线性表\",\n  \"description\": \"线性表基础（更新）\",\n  \"orderNum\": 1,\n  \"courseId\": 1\n}" } } },
        { "name": "删除章节（教师）", "request": { "method": "DELETE", "header": [], "url": { "raw": "{{baseUrl}}/api/chapters/999", "host": ["{{baseUrl}}"], "path": ["api", "chapters", "999"] } } }
      ]
    },
    {
      "name": "03-题库 Questions（教师）",
      "item": [
        { "name": "题目分页列表", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/questions?page=0&size=10", "host": ["{{baseUrl}}"], "path": ["api", "questions"], "query": [{"key":"page","value":"0"},{"key":"size","value":"10"}] } } },
        { "name": "题目详情（含答案）", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/questions/{{questionId}}", "host": ["{{baseUrl}}"], "path": ["api", "questions", "{{questionId}}"] } } },
        {
          "name": "新建题目（保存 newQuestionId）",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const res = pm.response.json();",
            "if (res.data && res.data.id) pm.collectionVariables.set('newQuestionId', res.data.id);"
          ] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/api/questions", "host": ["{{baseUrl}}"], "path": ["api", "questions"] },
            "body": { "mode": "raw", "raw": "{\n  \"content\": \"Postman 新建题：栈的特点？\",\n  \"options\": [\"A. 先进先出\", \"B. 后进先出\", \"C. 随机\"],\n  \"answer\": \"B\",\n  \"analysis\": \"栈 LIFO\",\n  \"knowledge\": \"栈\",\n  \"type\": \"single_choice\",\n  \"difficulty\": \"easy\",\n  \"isPublic\": true,\n  \"majorId\": 1,\n  \"courseId\": 1,\n  \"chapterId\": 2\n}" } }
        },
        { "name": "更新题目", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/api/questions/{{newQuestionId}}", "host": ["{{baseUrl}}"], "path": ["api", "questions", "{{newQuestionId}}"] }, "body": { "mode": "raw", "raw": "{\n  \"content\": \"Postman 更新题：队列的特点？\",\n  \"options\": [\"A. 先进先出\", \"B. 后进先出\"],\n  \"answer\": \"A\",\n  \"analysis\": \"队列 FIFO\",\n  \"knowledge\": \"队列\",\n  \"type\": \"single_choice\",\n  \"difficulty\": \"easy\",\n  \"isPublic\": false,\n  \"majorId\": 1,\n  \"courseId\": 1,\n  \"chapterId\": 2\n}" } } },
        { "name": "切换题目公开状态", "request": { "method": "POST", "header": [], "url": { "raw": "{{baseUrl}}/api/questions/{{newQuestionId}}/toggle_public", "host": ["{{baseUrl}}"], "path": ["api", "questions", "{{newQuestionId}}", "toggle_public"] } } },
        { "name": "删除题目", "request": { "method": "DELETE", "header": [], "url": { "raw": "{{baseUrl}}/api/questions/{{newQuestionId}}", "host": ["{{baseUrl}}"], "path": ["api", "questions", "{{newQuestionId}}"] } } }
      ]
    },
    {
      "name": "04-考试管理 Exams（教师）",
      "item": [
        { "name": "考试列表（角色自适应）", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/exams", "host": ["{{baseUrl}}"], "path": ["api", "exams"] } } },
        { "name": "考试详情", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/exams/{{examId}}", "host": ["{{baseUrl}}"], "path": ["api", "exams", "{{examId}}"] } } },
        {
          "name": "创建考试（保存 newExamId）",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const res = pm.response.json();",
            "if (res.data && res.data.id) pm.collectionVariables.set('newExamId', res.data.id);"
          ] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/api/exams", "host": ["{{baseUrl}}"], "path": ["api", "exams"] },
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Postman 测试考试\",\n  \"description\": \"接口联调用\",\n  \"startTime\": \"2026-09-20 09:00:00\",\n  \"endTime\": \"2026-09-20 11:00:00\",\n  \"duration\": 60\n}" } }
        },
        { "name": "更新考试", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/api/exams/{{newExamId}}", "host": ["{{baseUrl}}"], "path": ["api", "exams", "{{newExamId}}"] }, "body": { "mode": "raw", "raw": "{\n  \"title\": \"Postman 测试考试（改）\",\n  \"description\": \"更新描述\",\n  \"startTime\": \"2026-09-20 09:00:00\",\n  \"endTime\": \"2026-09-20 11:00:00\",\n  \"duration\": 90\n}" } } },
        { "name": "考试题目列表", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/exams/{{examId}}/questions", "host": ["{{baseUrl}}"], "path": ["api", "exams", "{{examId}}", "questions"] } } },
        { "name": "添加题目到考试", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/api/exams/{{newExamId}}/add_questions", "host": ["{{baseUrl}}"], "path": ["api", "exams", "{{newExamId}}", "add_questions"] }, "body": { "mode": "raw", "raw": "{\n  \"questionIds\": [1, 2, 3]\n}" } } },
        { "name": "从考试移除题目", "request": { "method": "POST", "header": [], "url": { "raw": "{{baseUrl}}/api/exams/{{newExamId}}/remove_question/3", "host": ["{{baseUrl}}"], "path": ["api", "exams", "{{newExamId}}", "remove_question", "3"] } } },
        { "name": "生成邀请码/链接", "request": { "method": "POST", "header": [], "url": { "raw": "{{baseUrl}}/api/exams/{{examId}}/generate_invitation", "host": ["{{baseUrl}}"], "path": ["api", "exams", "{{examId}}", "generate_invitation"] } } },
        { "name": "考试学生列表", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/exams/{{examId}}/students", "host": ["{{baseUrl}}"], "path": ["api", "exams", "{{examId}}", "students"] } } },
        { "name": "邀请学生参加考试", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/api/exams/{{examId}}/invite", "host": ["{{baseUrl}}"], "path": ["api", "exams", "{{examId}}", "invite"] }, "body": { "mode": "raw", "raw": "{\n  \"studentIds\": [3]\n}" } } },
        { "name": "移除考试学生", "request": { "method": "POST", "header": [], "url": { "raw": "{{baseUrl}}/api/exams/{{newExamId}}/remove_student/3", "host": ["{{baseUrl}}"], "path": ["api", "exams", "{{newExamId}}", "remove_student", "3"] } } },
        { "name": "智能组卷", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/api/exams/{{newExamId}}/smart_composition", "host": ["{{baseUrl}}"], "path": ["api", "exams", "{{newExamId}}", "smart_composition"] }, "body": { "mode": "raw", "raw": "{\n  \"majorId\": 1,\n  \"type\": \"single_choice\",\n  \"difficulty\": \"easy\",\n  \"sourceFilter\": \"all\",\n  \"count\": 2\n}" } } },
        { "name": "发布考试（需有题+起止时间）", "request": { "method": "POST", "header": [], "url": { "raw": "{{baseUrl}}/api/exams/{{newExamId}}/publish", "host": ["{{baseUrl}}"], "path": ["api", "exams", "{{newExamId}}", "publish"] } } },
        { "name": "结束考试", "request": { "method": "POST", "header": [], "url": { "raw": "{{baseUrl}}/api/exams/{{examId}}/end", "host": ["{{baseUrl}}"], "path": ["api", "exams", "{{examId}}", "end"] } } },
        { "name": "删除考试", "request": { "method": "DELETE", "header": [], "url": { "raw": "{{baseUrl}}/api/exams/{{newExamId}}", "host": ["{{baseUrl}}"], "path": ["api", "exams", "{{newExamId}}"] } } }
      ]
    },
    {
      "name": "05-学生：考试列表/加入",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{studentToken}}", "type": "string" }] },
      "item": [
        { "name": "全部学生列表（教师）", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/students", "host": ["{{baseUrl}}"], "path": ["api", "students"] } } },
        { "name": "学生-我的考试", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/exams", "host": ["{{baseUrl}}"], "path": ["api", "exams"] } } },
        { "name": "学生-邀请码加入考试", "request": { "method": "POST", "header": [], "url": { "raw": "{{baseUrl}}/api/exam/join/{{invitationCode}}", "host": ["{{baseUrl}}"], "path": ["api", "exam", "join", "{{invitationCode}}"] } } }
      ]
    },
    {
      "name": "06-学生：在线答题",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{studentToken}}", "type": "string" }] },
      "item": [
        { "name": "开始考试（建立会话）", "request": { "method": "POST", "header": [], "url": { "raw": "{{baseUrl}}/api/exam/{{examId}}/start", "host": ["{{baseUrl}}"], "path": ["api", "exam", "{{examId}}", "start"] } } },
        { "name": "拉取试卷（无答案）", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/exam/{{examId}}/take", "host": ["{{baseUrl}}"], "path": ["api", "exam", "{{examId}}", "take"] } } },
        { "name": "保存单题答案", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/api/exam/{{examId}}/save_answer", "host": ["{{baseUrl}}"], "path": ["api", "exam", "{{examId}}", "save_answer"] }, "body": { "mode": "raw", "raw": "{\n  \"questionId\": 1,\n  \"studentAnswer\": \"A\"\n}" } } },
        { "name": "上报切屏", "request": { "method": "POST", "header": [], "url": { "raw": "{{baseUrl}}/api/exam/{{examId}}/report_switch", "host": ["{{baseUrl}}"], "path": ["api", "exam", "{{examId}}", "report_switch"] } } },
        { "name": "交卷", "request": { "method": "POST", "header": [], "url": { "raw": "{{baseUrl}}/api/exam/{{examId}}/submit", "host": ["{{baseUrl}}"], "path": ["api", "exam", "{{examId}}", "submit"] } } },
        { "name": "查看我的考试报告", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/exam/{{examId}}/report", "host": ["{{baseUrl}}"], "path": ["api", "exam", "{{examId}}", "report"] } } }
      ]
    },
    {
      "name": "07-成绩与批改 Results",
      "item": [
        { "name": "学生-我的成绩", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{studentToken}}", "type": "string" }] }, "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/results/me", "host": ["{{baseUrl}}"], "path": ["api", "results", "me"] } } },
        { "name": "教师-考试成绩列表", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/results/exam/{{examId}}", "host": ["{{baseUrl}}"], "path": ["api", "results", "exam", "{{examId}}"] } } },
        { "name": "成绩详情（本人或教师）", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/results/1", "host": ["{{baseUrl}}"], "path": ["api", "results", "1"] } } },
        { "name": "教师-待批改学生列表", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/results/grading/{{examId}}", "host": ["{{baseUrl}}"], "path": ["api", "results", "grading", "{{examId}}"] } } },
        { "name": "教师-学生答卷明细", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/results/grading/{{examId}}/{{studentId}}", "host": ["{{baseUrl}}"], "path": ["api", "results", "grading", "{{examId}}", "{{studentId}}"] } } },
